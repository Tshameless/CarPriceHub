# Docker Compose 环境变量配置
# 请复制此文件为 .env 并修改相应的值

# ── 数据库配置 ───────────────────────────────────
DB_PASSWORD=your-strong-password-here

# ── JWT 配置 ────────────────────────────────────
# 使用以下命令生成强密钥:
# openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here

# ── 可选: 外部服务 ──────────────────────────────
# 如果使用外部数据库,取消注释并配置
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── 生产环境配置 ────────────────────────────────
NODE_ENV=production
